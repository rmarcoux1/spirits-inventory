# Base URL of the deployed HTTP API (from the CDK `ApiUrl` output)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Value of the ApiSharedSecret (from the CDK `ApiSecretArn` output, read via
# `aws secretsmanager get-secret-value --secret-id <ApiSecretArn> --query SecretString --output text`)
VITE_API_KEY=changeme
